@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<div class="auth-page">
	<div class="auth-card">
		<div class="auth-brand">
			<img src="~/Images/FoodLogo.png" alt="OrderIt logo" />
			<h1 class="auth-title">@ViewData["Title"]</h1>
			<p class="auth-subtitle">Enter your email and we'll send you a reset link.</p>
		</div>

		<form method="post">
			<div asp-validation-summary="ModelOnly" class="text-danger small mb-2" role="alert"></div>
			<div class="form-floating mb-3">
				<input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
				<label asp-for="Input.Email" class="form-label">Email</label>
				<span asp-validation-for="Input.Email" class="text-danger small"></span>
			</div>
			<button type="submit" class="w-100 btn btn-primary btn-lg">Reset Password</button>
		</form>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}