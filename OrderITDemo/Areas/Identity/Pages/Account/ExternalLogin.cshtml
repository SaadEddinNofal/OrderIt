@page
@model ExternalLoginModel
@{
    ViewData["Title"] = "Register";
}

<div class="auth-page">
	<div class="auth-card">
		<div class="auth-brand">
			<img src="~/Images/FoodLogo.png" alt="OrderIt logo" />
			<h1 class="auth-title">@ViewData["Title"]</h1>
			<p class="auth-subtitle" id="external-login-description">
				You've successfully authenticated with <strong>@Model.ProviderDisplayName</strong>.
				Please enter an email address below and click the Register button to finish logging in.
			</p>
		</div>

		<form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post">
			<div asp-validation-summary="ModelOnly" class="text-danger small mb-2" role="alert"></div>
			<div class="form-floating mb-3">
				<input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="Please enter your email." />
				<label asp-for="Input.Email" class="form-label">Email</label>
				<span asp-validation-for="Input.Email" class="text-danger small"></span>
			</div>
			<button type="submit" class="w-100 btn btn-primary btn-lg">Register</button>
		</form>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}