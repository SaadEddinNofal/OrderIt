@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Recovery code verification";
}

<div class="auth-page">
	<div class="auth-card">
		<div class="auth-brand">
			<img src="~/Images/FoodLogo.png" alt="OrderIt logo" />
			<h1 class="auth-title">@ViewData["Title"]</h1>
			<p class="auth-subtitle">You have requested to log in with a recovery code. This login will not be remembered until you provide an authenticator app code at log in or disable 2FA and log in again.</p>
		</div>

		<form method="post">
			<div asp-validation-summary="ModelOnly" class="text-danger small mb-2" role="alert"></div>
			<div class="form-floating mb-3">
				<input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" placeholder="Recovery Code" />
				<label asp-for="Input.RecoveryCode" class="form-label">Recovery Code</label>
				<span asp-validation-for="Input.RecoveryCode" class="text-danger small"></span>
			</div>
			<button type="submit" class="w-100 btn btn-primary btn-lg">Log in</button>
		</form>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}