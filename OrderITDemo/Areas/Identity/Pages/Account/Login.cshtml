@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="auth-page">
	<div class="auth-card">
		<div class="auth-brand">
			<img src="~/Images/FoodLogo.png" alt="OrderIt logo" />
			<h1 class="auth-title">OrderIt</h1>
			<p class="auth-subtitle">Welcome back! Log in to continue.</p>
		</div>

		<section>
			<form id="account" method="post">
				<div asp-validation-summary="ModelOnly" class="text-danger small mb-2" role="alert"></div>

				<div class="form-floating mb-3">
					<input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
					<label asp-for="Input.Email" class="form-label">Email</label>
					<span asp-validation-for="Input.Email" class="text-danger small"></span>
				</div>
				<div class="form-floating mb-3">
					<input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
					<label asp-for="Input.Password" class="form-label">Password</label>
					<span asp-validation-for="Input.Password" class="text-danger small"></span>
				</div>
				<div class="form-check mb-3">
					<input class="form-check-input" asp-for="Input.RememberMe" />
					<label asp-for="Input.RememberMe" class="form-check-label">
						@Html.DisplayNameFor(m => m.Input.RememberMe)
					</label>
				</div>
				<div>
					<button id="login-submit" type="submit" class="w-100 btn btn-primary btn-lg mb-3">Log in</button>
				</div>
			</form>
		</section>

		<div class="auth-links text-center small">
			<p class="mb-1">
				<i class="bi bi-shield-lock me-1"></i><a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a>
			</p>
			<p class="mb-0">
				Don't have an account? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register as a new user</a>
			</p>
			<p class="mb-0">
				<a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Resend email confirmation</a>
			</p>
		</div>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}