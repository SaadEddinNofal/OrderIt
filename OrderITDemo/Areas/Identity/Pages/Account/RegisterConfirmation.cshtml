@page
@model RegisterConfirmationModel
@{
	ViewData["Title"] = "Register confirmation";
}

<div class="result-page">
	<div class="result-card">
		<div class="result-icon bg-success-soft text-success"><i class="bi bi-check-circle"></i></div>
		<h1 class="h4 mb-3">@ViewData["Title"]</h1>
		<p class="text-muted mb-0">Please check your email to confirm your account.</p>
		<a class="btn btn-outline-primary mt-4" asp-page="./Login">Go to Login</a>
	</div>
</div>