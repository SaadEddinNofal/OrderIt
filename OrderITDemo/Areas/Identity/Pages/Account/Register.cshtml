@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<style>
    body {
        font-family: Roboto, Arial, sans-serif;
        background-image: url('../Images/BurgerBK.jpg');
        background-size: cover;
        background-position: center;
        min-height: 100vh;
    }

    .container-register {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 0;
    }

    .account-box {
        background: rgba(255,255,255,0.95);
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.12);
        padding: 2rem 2.5rem;
        max-width: 400px;
        width: 100%;
        margin: 0 auto;
    }

    label {
        color: orangered;
    }

    .blurred-image {
        display: none;
    }
    
        .account-box
    {
        padding: 1rem 0.5rem;
        max-width: 100%;
    }

    h3 {
        font-size: 2rem !important;
    }
</style>

<div class="container-register">
    <div class="account-box text-center">
        <h3 style="font-family:Roboto; font-size:2.5rem; text-shadow: 1px 2px 7px rgba(0, 0, 0, 0.1); color: darkorange;" class="fw-bold mb-4">OrderIt</h3>
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <h2 class="mb-3" style="font-size:1.25rem;">Create a new account.</h2>
            <hr />
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-2">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="" />
                <label asp-for="Input.Email">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="form-floating mb-2">
                <input asp-for="Input.FirstName" maxlength="20" class="form-control" autocomplete="username" aria-required="true" placeholder="" />
                <label asp-for="Input.FirstName">First Name</label>
                <span asp-validation-for="Input.FirstName" class="text-danger"></span>
            </div>
            <div class="form-floating mb-2">
                <input asp-for="Input.PhoneNumber" maxlength="20" class="form-control" autocomplete="username" aria-required="true" placeholder="" />
                <label asp-for="Input.PhoneNumber">Phone Number</label>
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>
            <div class="form-floating mb-2">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="" />
                <label asp-for="Input.Password">Password</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="form-floating mb-2">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="" />
                <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <button id="registerSubmit" type="submit" style="background-color:darkorange;color:white" class="w-100 btn btn-lg shadow">Register</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}