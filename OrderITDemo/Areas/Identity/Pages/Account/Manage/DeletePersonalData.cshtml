@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Delete Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3 class="h5 mb-3">@ViewData["Title"]</h3>

<div class="form-card">
	<div class="form-card-header">
		<p class="text-danger fw-semibold mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Deleting this data will permanently remove your account, and this cannot be recovered.</p>
	</div>
	<form id="delete-user" method="post">
		<div class="form-card-body">
			<div asp-validation-summary="ModelOnly" class="text-danger small mb-2" role="alert"></div>
			@if (Model.RequirePassword)
			{
				<div class="form-floating mb-3">
					<input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Please enter your password." />
					<label asp-for="Input.Password" class="form-label">Password</label>
					<span asp-validation-for="Input.Password" class="text-danger small"></span>
				</div>
			}
		</div>
		<div class="form-card-footer d-flex justify-content-end">
			<button class="btn btn-danger" type="submit">Delete data and close my account</button>
		</div>
	</form>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}