@page
@model IndexModel
@{
	ViewData["Title"] = "Profile";
	ViewData["ActivePage"] = ManageNavPages.Index;
}

<h3 class="h5 mb-3">@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<div class="form-card">
	<form id="profile-form" method="post" enctype="multipart/form-data">
		<div class="form-card-body">
			<div class="row g-4">
				<div class="col-md-7">
					<div asp-validation-summary="ModelOnly" class="text-danger small mb-2" role="alert"></div>
					<div class="form-floating mb-3">
						<input asp-for="Username" class="form-control" placeholder="Please choose your username." disabled />
						<label asp-for="Username" class="form-label">Username</label>
					</div>
					<div class="form-floating mb-3">
						<input asp-for="Input.PhoneNumber" class="form-control" placeholder="Please enter your Phone Number." />
						<label asp-for="Input.PhoneNumber" class="form-label">Phone Number</label>
						<span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
					</div>
					<div class="form-floating mb-3">
						<input asp-for="Input.FirstName" class="form-control" placeholder="Please enter your First Name." />
						<label asp-for="Input.FirstName" class="form-label">First Name</label>
						<span asp-validation-for="Input.FirstName" class="text-danger small"></span>
					</div>
				</div>
				<div class="col-md-5 d-flex flex-column align-items-center gap-3">
					@if (Model.Input.ProfilePicture != null)
					{
						<img id="ProfilePicture" alt="Profile" src="data:image/*;base64,@(Convert.ToBase64String(Model.Input.ProfilePicture))" class="profile-avatar rounded-circle" />
					}
					else
					{
						<img id="ProfilePicture" alt="Profile" src="~/Images/Profile.jpg" class="profile-avatar rounded-circle" />
					}
					<div class="w-100">
						<label asp-for="Input.ProfilePicture" class="form-label d-block text-center">Choose picture</label>
						<input type="file" accept="image/*" asp-for="Input.ProfilePicture" class="form-control form-control-sm"
							   onchange="document.getElementById('ProfilePicture').src = window.URL.createObjectURL(this.files[0])" />
						<span asp-validation-for="Input.ProfilePicture" class="text-danger small"></span>
					</div>
				</div>
			</div>
		</div>
		<div class="form-card-footer d-flex justify-content-end">
			<button id="update-profile-button" type="submit" class="btn btn-primary">Save</button>
		</div>
	</form>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}