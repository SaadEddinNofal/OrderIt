@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3 class="h5 mb-3">@ViewData["Title"]</h3>

<div class="form-card">
	<div class="form-card-body">
		<p>Your account contains personal data that you have given us. This page allows you to download or delete that data.</p>
		<div class="alert alert-warning" role="alert">
			<strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
		</div>
		<div class="d-flex gap-2">
			<form id="download-data" asp-page="DownloadPersonalData" method="post">
				<button class="btn btn-primary" type="submit"><i class="bi bi-download me-1"></i>Download</button>
			</form>
			<a id="delete" asp-page="DeletePersonalData" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Delete</a>
		</div>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}