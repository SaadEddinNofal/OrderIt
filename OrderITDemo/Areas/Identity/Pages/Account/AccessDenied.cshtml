@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}

<div class="result-page">
	<div class="result-card">
		<div class="result-icon bg-danger-soft text-danger"><i class="bi bi-shield-x"></i></div>
		<h1 class="h4 mb-3">@ViewData["Title"]</h1>
		<p class="text-muted mb-0">You do not have access to this resource.</p>
		<a class="btn btn-outline-primary mt-4" asp-area="" asp-controller="Home" asp-action="Index">Back to Home</a>
	</div>
</div>