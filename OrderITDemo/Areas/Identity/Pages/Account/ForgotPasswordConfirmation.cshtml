@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Forgot password confirmation";
}

<div class="result-page">
	<div class="result-card">
		<div class="result-icon bg-primary-soft text-primary"><i class="bi bi-envelope-check"></i></div>
		<h1 class="h4 mb-3">@ViewData["Title"]</h1>
		<p class="text-muted mb-0">Please check your email to reset your password.</p>
		<a class="btn btn-outline-primary mt-4" asp-page="./Login">Back to Login</a>
	</div>
</div>