@model IEnumerable<Category>
@{
    
	Layout = "_AdminLayout";
	ViewData["Title"] = "The Menu";

}

<div class="page-wrap">
	<div class="container py-5">
		<div class="page-header">
			<h1>The Menu</h1>
			<p class="page-subtitle">Manage menu items by category.</p>
		</div>

		@foreach (var menu in Model)
		{
			<h2 class="section-title">@menu.Name</h2>

			<div class="row g-4">
				@foreach (var m in menu.Menu)
				{
					<div class="col-lg-3 col-md-4 col-sm-6">
						<div class="card menu-card">
							<div class="card-img-wrap">
								@if (m.ItemPicture != null)
								{
									<img alt="@m.Name" src="data:image/*;base64,@(Convert.ToBase64String(m.ItemPicture))" />
								}
								else
								{
									<img alt="@m.Name" src="~/Images/EmptyPlate.jpg" />
								}
							</div>
							<div class="card-body">
								<h3 class="card-title">@m.Name</h3>
								<p class="card-text">@m.Description</p>
								<div class="d-flex align-items-center justify-content-between">
									<span class="menu-price">@m.Price</span>
									@if (m.IsExist)
									{
										<span class="badge bg-success">Available</span>
									}
									else
									{
										<span class="badge bg-danger">Unavailable</span>
									}
								</div>
								<div class="card-actions">
									<a asp-action="Add" asp-controller="Menu" class="btn btn-outline-primary btn-sm" asp-route-id="@m.MenuId"><i class="bi bi-pencil me-1"></i>Edit</a>
									<a asp-action="Delete" asp-controller="Menu" class="btn btn-outline-danger btn-sm" asp-route-id="@m.MenuId"><i class="bi bi-trash me-1"></i>Delete</a>
								</div>
							</div>
						</div>
					</div>
				}
			</div>
		}
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}