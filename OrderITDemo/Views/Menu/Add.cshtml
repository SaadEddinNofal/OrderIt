@model Menu
@{
    ViewData["Title"] = "إضافة منيو جديد";
}

<form method="post" id="profile-form" enctype="multipart/form-data">
    <div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh; background-color: #f8f4f0;">
        <div class="p-4 shadow-lg rounded" style="width:100%; max-width: 75%; background-color: #fff8f0;">
            <h2 class="text-center text-dark mb-4" style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">@ViewData["Title"]</h2>

            <div class="row g-4">
                <!-- الاسم -->
                <div class="col-12 col-md-6">
                    <div class="form-floating mb-3">
                        <input asp-for="Name" class="form-control" placeholder="اسم الوجبة" />
                        <label asp-for="Name">اسم الوجبة</label>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                </div>
                <!-- السعر -->
                <div class="col-12 col-md-6">
                    <div class="form-floating mb-3">
                        <input asp-for="Price" class="form-control" placeholder="السعر" type="number" step="0.01" />
                        <label asp-for="Price">السعر</label>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                </div>
                <!-- الوصف -->
                <div class="col-12 mb-3">
                    <div class="form-floating">
                        <textarea asp-for="Description" class="form-control" placeholder="تفاصيل الوجبة" style="height: 100px;"></textarea>
                        <label asp-for="Description">تفاصيل الوجبة</label>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>
                <!-- الفئة -->
                <div class="col-12 col-md-6">
                    <div class="form-floating mb-3">
                        <select asp-for="CategoryId" class="form-select" required>
                            <option value="">-- اختر الفئة --</option>
                            @foreach (var category in ViewBag.E)
                            {
                                <option value="@category.CategoryId">@category.Name</option>
                            }
                        </select>
                        <label asp-for="CategoryId">الفئة</label>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>
                </div>
                <!-- حالة الوجود -->
                <div class="col-12 col-md-6 d-flex align-items-center mb-3">
                    <div class="form-check">
                        <input type="checkbox" asp-for="IsExist" class="form-check-input" id="IsExistCheckbox" />
                        <label class="form-check-label" for="IsExistCheckbox">متوفر حالياً</label>
                    </div>
                </div>
                <!-- صورة الوجبة -->
                <div class="col-12 d-flex flex-column align-items-center mb-4">
                    @if (Model != null && Model.ItemPicture != null)
                    {
                        <img id="ProfilePicture" src="data:image/*;base64,@(Convert.ToBase64String(Model.ItemPicture))" class="rounded mb-3 shadow-sm" style="max-height:250px; object-fit:cover;" />
                    }
                    else
                    {
                        <img id="ProfilePicture" src="~/Images/EmptyPlate.jpg" class="rounded mb-3 shadow-sm" style="max-height:250px; object-fit:cover;" />
                    }
                    <input type="file" accept="image/*" asp-for="MenuFile" class="form-control form-control-sm" onchange="loadFile(event)" />
                </div>
                <!-- زر الحفظ -->
                <div class="col-12 text-center">
                    <button type="submit" class="btn btn-success px-4 py-2 shadow-sm" style="font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">حفظ البيانات</button>
                </div>
            </div>
        </div>
    </div>
</form>
<h2>Events</h2>
<br />
<div id="container1">
    <input type="button" id="btn1" value="Click me!" class="btn btn-warning" />
</div>
<div id="clearfix"></div>
<div id="container2">
    <input type="button" id="btn2" value="Click me!" class="btn btn-success" />
</div>
<br />
<input type="text" id="txtNum" class="form-control" />
<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script>
    $(document).ready(function () { });
</script>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>

        function loadFile(event) {
            var reader = new FileReader();
            reader.onload = function() {
                document.getElementById('ProfilePicture').src = reader.result;
            }
            reader.readAsDataURL(event.target.files[0]);
        }
    </script>
    <script>
       
 $(document).ready(function () {
 $('#container1').delegate('.btn', 'click', function () {
 str = '<input type="button" id="btn1" value ="Click me!" class="btn btn-warning" />'
 $(this).parent().append(str);
 });
 $('#container2').on('click','.btn' ,function () {
 str = '<input type="button" id="btn2" value="Click me!" class="btn btn-success" />'
 $(this).parent().append(str);
 });
 $('#txtNum').keydown(function (event) {
 alert(event.which);
 });
 });
 </script>

}  