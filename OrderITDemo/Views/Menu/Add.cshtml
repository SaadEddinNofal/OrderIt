@model Menu
@{
    
	Layout = "_AdminLayout";
	ViewData["Title"] = "إضافة منيو جديد";

}

<div class="page-wrap">
	<div class="container py-5">
		<div class="row justify-content-center">
			<div class="col-lg-8 col-md-10">
				<div class="form-card">
					<div class="form-card-header">
						<h1 class="h4 mb-0">@ViewData["Title"]</h1>
					</div>

					<form method="post" id="profile-form" enctype="multipart/form-data">
						<div class="form-card-body">
							<div class="row g-4">
								<div class="col-12 col-md-6">
									<div class="form-floating">
										<input asp-for="Name" class="form-control" placeholder="اسم الوجبة" />
										<label asp-for="Name">اسم الوجبة</label>
										<span asp-validation-for="Name" class="text-danger small"></span>
									</div>
								</div>
								<div class="col-12 col-md-6">
									<div class="form-floating">
										<input asp-for="Price" class="form-control" placeholder="السعر" type="number" step="0.01" />
										<label asp-for="Price">السعر</label>
										<span asp-validation-for="Price" class="text-danger small"></span>
									</div>
								</div>
								<div class="col-12">
									<div class="form-floating">
										<textarea asp-for="Description" class="form-control" placeholder="تفاصيل الوجبة" style="height: 100px;"></textarea>
										<label asp-for="Description">تفاصيل الوجبة</label>
										<span asp-validation-for="Description" class="text-danger small"></span>
									</div>
								</div>
								<div class="col-12 col-md-6">
									<div class="form-floating">
										<select asp-for="CategoryId" class="form-select" required>
											<option value="">-- اختر الفئة --</option>
											@foreach (var category in ViewBag.E)
											{
												<option value="@category.CategoryId">@category.Name</option>
											}
										</select>
										<label asp-for="CategoryId">الفئة</label>
										<span asp-validation-for="CategoryId" class="text-danger small"></span>
									</div>
								</div>
								<div class="col-12 col-md-6 d-flex align-items-center">
									<div class="form-check">
										<input type="checkbox" asp-for="IsExist" class="form-check-input" id="IsExistCheckbox" />
										<label class="form-check-label" for="IsExistCheckbox">متوفر حالياً</label>
									</div>
								</div>
								<div class="col-12 d-flex flex-column align-items-center gap-3">
									@if (Model != null && Model.ItemPicture != null)
									{
										<img id="ProfilePicture" src="data:image/*;base64,@(Convert.ToBase64String(Model.ItemPicture))" class="rounded shadow-sm img-thumbnail" alt="Meal picture" style="max-height:250px; object-fit:cover;" />
									}
									else
									{
										<img id="ProfilePicture" src="~/Images/EmptyPlate.jpg" class="rounded shadow-sm img-thumbnail" alt="Default meal picture" style="max-height:250px; object-fit:cover;" />
									}
									<input type="file" accept="image/*" asp-for="MenuFile" class="form-control form-control-sm" onchange="loadFile(event)" />
								</div>
							</div>
						</div>

						<div class="form-card-footer d-flex justify-content-end gap-2">
							<a asp-controller="Menu" asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
							<button type="submit" class="btn btn-primary px-4">حفظ البيانات</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
	<script>
		function loadFile(event) {
			var reader = new FileReader();
			reader.onload = function () {
				document.getElementById('ProfilePicture').src = reader.result;
			}
			reader.readAsDataURL(event.target.files[0]);
		}
	</script>
}