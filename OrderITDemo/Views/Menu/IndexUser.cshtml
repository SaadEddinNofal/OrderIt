@model IEnumerable<Category>
@{
    ViewData["Title"] = "The Menu";
}

<div class="page-wrap">
	<div class="container py-5" dir="rtl">
		<div class="page-header">
			<h1>The Menu</h1>
			<p class="page-subtitle">Choose your meal and add it to the cart.</p>
		</div>

		@foreach (var menu in Model)
		{
			<h2 class="section-title">@menu.Name</h2>

			<div class="row g-4 justify-content-center">
				@foreach (var m in menu.Menu)
				{
					if (m.IsExist)
					{
						<div class="col-lg-3 col-md-4 col-sm-6 d-flex align-items-stretch">
							<div class="card menu-card">
								<div class="card-img-wrap">
									@if (m.ItemPicture != null)
									{
										<img alt="@m.Name" src="data:image/*;base64,@(Convert.ToBase64String(m.ItemPicture))" />
									}
									else
									{
										<img alt="@m.Name" src="~/Images/EmptyPlate.jpg" />
									}
								</div>
								<div class="card-body">
									<h3 class="card-title">@m.Name</h3>
									<p class="card-text">@m.Description</p>
									<div class="d-flex align-items-center justify-content-between">
										<span class="menu-price">@m.Price ل.س</span>
										@if (User.IsInRole("Admin"))
										{
											<a asp-action="Add" asp-controller="Menu" class="btn btn-outline-primary btn-sm" asp-route-id="@m.MenuId">تعديل</a>
											<a asp-action="Delete" asp-controller="Menu" class="btn btn-outline-danger btn-sm" asp-route-id="@m.MenuId">حذف</a>
										}
										@if (User.IsInRole("User") || !User.Identity.IsAuthenticated)
										{
											<a asp-action="AddToCart" asp-controller="Cart" class="btn btn-primary btn-sm" asp-route-menuId="@m.MenuId"><i class="bi bi-cart-plus me-1"></i>إضافة إلى السلة</a>
										}
									</div>
								</div>
							</div>
						</div>
					}
				}
			</div>
		}
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}