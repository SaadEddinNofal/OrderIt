@model CartViewModel

<div class="page-wrap">
	<div class="container py-5">
		<div class="page-header">
			<h1>Your Cart</h1>
			<p class="page-subtitle">Review your items and confirm your order.</p>
		</div>

		@if (Model != null && Model.Carts.Any())
		{
			<div class="cart-layout">
				<div>
					@foreach (var cart in Model.Carts)
					{
						<div class="cart-item">
							@if (cart.Menu.ItemPicture != null)
							{
								<img class="cart-item-img" alt="@cart.Menu.Name" src="data:image/*;base64,@(Convert.ToBase64String(cart.Menu.ItemPicture))" />
							}
							else
							{
								<img class="cart-item-img" alt="@cart.Menu.Name" src="~/Images/EmptyPlate.jpg" />
							}
							<div>
								<p class="cart-item-name">@cart.Menu.Name</p>
								<p class="cart-item-meta">@cart.Menu.Price ل.س</p>
							</div>
							<div class="text-end">
								<div class="qty-control mb-2">
									<a asp-action="AddToCart" asp-route-tot="@(cart.Menu.Price * cart.Quantity)" asp-controller="Cart" asp-route-cartId="@cart.CartItemId" asp-route-menuId="@cart.MenuId" class="qty-btn" title="Add" aria-label="Increase quantity"><i class="bi bi-plus"></i></a>
									<span class="qty-value">@cart.Quantity</span>
									<a asp-action="Minus" asp-controller="Cart" asp-route-cartId="@cart.CartItemId" asp-route-menuId="@cart.MenuId" class="qty-btn" title="Minus" aria-label="Decrease quantity"><i class="bi bi-dash"></i></a>
								</div>
								<span class="cart-item-price">@cart.TotalPrice ل.س</span>
							</div>
							<a asp-action="Delete" asp-controller="Cart" asp-route-id="@cart.CartItemId" class="btn btn-sm btn-outline-danger" title="Remove"><i class="bi bi-trash3"></i></a>
						</div>
					}
				</div>

				<aside class="form-card summary-card">
					<div class="form-card-header">
						<h2 class="h5 mb-0">Order Summary</h2>
					</div>
					<form method="post" asp-action="AddOrder" asp-controller="Order">
						<div class="form-card-body">
							<div class="form-floating mb-3">
								<input asp-for="Address" id="addressInput" class="form-control" autocomplete="street-address" aria-required="true" placeholder="" required />
								<label asp-for="Address">Address</label>
								<span asp-validation-for="Address" class="text-danger"></span>
							</div>
							<div class="sum-line">
								<span>@Model.Carts.Count() item(s)</span>
								<span>@Model.Carts.Sum(c => c.Quantity) pieces</span>
							</div>
							<div class="sum-line total">
								<span>Total</span>
								<span class="amount">@Model.Carts.Sum(c => c.TotalPrice) ل.س</span>
							</div>
						</div>
						<div class="form-card-footer">
							<button type="submit" class="btn btn-primary w-100"><i class="bi bi-bag-check me-2"></i>Place Order</button>
						</div>
					</form>
				</aside>
			</div>

			<div id="map" class="mt-4"></div>
		}
		else
		{
			<div class="empty-state">
				<i class="bi bi-cart3 empty-icon"></i>
				<h3>Your cart is empty</h3>
				<p>Looks like you haven't added anything yet. Browse the menu and order your favourite meal.</p>
				<a class="btn btn-primary" asp-controller="Menu" asp-action="IndexUser">Browse Menu</a>
			</div>
		}
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
	@if (Model != null && Model.Carts.Any())
	{
		<script src="~/lib/leaflet/leaflet.min.js"></script>
		<script>
			var map = L.map('map').setView([32.0213, 35.0], 8);
			L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
				attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
			}).addTo(map);

			var marker;

			function setAddressFromCoords(lat, lng) {
				fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}`)
					.then(response => response.json())
					.then(data => {
						if (data && data.display_name) {
							document.getElementById('addressInput').value = data.display_name;
						} else {
							document.getElementById('addressInput').value = lat + ', ' + lng;
						}
					})
					.catch(() => {
						document.getElementById('addressInput').value = lat + ', ' + lng;
					});
			}

			map.on('click', function (e) {
				var lat = e.latlng.lat;
				var lng = e.latlng.lng;

				if (marker) {
					marker.setLatLng(e.latlng);
				} else {
					marker = L.marker(e.latlng, { draggable: true }).addTo(map);
					marker.on('dragend', function (event) {
						var position = event.target.getLatLng();
						setAddressFromCoords(position.lat, position.lng);
					});
				}
				setAddressFromCoords(lat, lng);
			});
		</script>
	}
}