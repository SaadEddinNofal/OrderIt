@model FileProfileViewModel
@{
	
	Layout = "_AdminLayout";
	ViewBag.Title = "Edit Profile";

}

<div class="page-wrap">
	<div class="container py-5">
		<div class="row justify-content-center">
			<div class="col-lg-6 col-md-8">
				<div class="form-card">
					<div class="form-card-header">
						<h1 class="h4 mb-0">@ViewBag.Title</h1>
					</div>

					<form id="registerForm" asp-action="Edit" method="post">
						<div class="form-card-body">
							<input type="hidden" asp-for="Id" />

							<div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

							<div class="row g-3">
								<div class="col-12">
									<div class="form-floating">
										<input asp-for="Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
										<label asp-for="Email">Email</label>
										<span asp-validation-for="Email" class="text-danger"></span>
									</div>
								</div>
								<div class="col-12 col-md-6">
									<div class="form-floating">
										<input asp-for="FirstName" maxlength="20" class="form-control" placeholder="First Name" />
										<label asp-for="FirstName">First Name</label>
										<span asp-validation-for="FirstName" class="text-danger"></span>
									</div>
								</div>
								<div class="col-12 col-md-6">
									<div class="form-floating">
										<input asp-for="PhoneNumber" maxlength="20" class="form-control" placeholder="Phone Number" />
										<label asp-for="PhoneNumber">Phone Number</label>
										<span asp-validation-for="PhoneNumber" class="text-danger"></span>
									</div>
								</div>
								<div class="col-12">
									<div class="form-floating">
										<input asp-for="UserName" maxlength="20" class="form-control" placeholder="User Name" />
										<label asp-for="UserName">User Name</label>
										<span asp-validation-for="UserName" class="text-danger"></span>
									</div>
								</div>
							</div>
						</div>

						<div class="form-card-footer d-flex justify-content-end gap-2">
							<a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
							<button id="registerSubmit" type="submit" class="btn btn-primary">Save</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}