@model AddUserViewModel
@{
    
	Layout = "_AdminLayout";
	ViewBag.Title = "Add User";

}

<div class="page-wrap">
	<div class="container py-5">
		<div class="row justify-content-center">
			<div class="col-lg-7 col-md-9">
				<div class="form-card">
					<div class="form-card-header">
						<h1 class="h4 mb-0">@ViewBag.Title</h1>
					</div>

					<form id="registerForm" asp-action="Add" method="post">
						<div class="form-card-body">
							<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

							<div class="row g-3">
								<div class="col-12">
									<div class="form-floating">
										<input asp-for="Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
										<label asp-for="Email">Email</label>
										<span asp-validation-for="Email" class="text-danger"></span>
									</div>
								</div>
								<div class="col-12 col-md-6">
									<div class="form-floating">
										<input asp-for="FirstName" maxlength="20" class="form-control" autocomplete="name" aria-required="true" placeholder="First Name" />
										<label asp-for="FirstName">First Name</label>
										<span asp-validation-for="FirstName" class="text-danger"></span>
									</div>
								</div>
								<div class="col-12 col-md-6">
									<div class="form-floating">
										<input asp-for="PhoneNumber" maxlength="20" class="form-control" autocomplete="tel" aria-required="true" placeholder="Phone Number" />
										<label asp-for="PhoneNumber">Phone Number</label>
										<span asp-validation-for="PhoneNumber" class="text-danger"></span>
									</div>
								</div>
								<div class="col-12">
									<div class="form-floating">
										<input asp-for="UserName" maxlength="20" class="form-control" autocomplete="username" aria-required="true" placeholder="User Name" />
										<label asp-for="UserName">User Name</label>
										<span asp-validation-for="UserName" class="text-danger"></span>
									</div>
								</div>
								<div class="col-12 col-md-6">
									<div class="form-floating">
										<input asp-for="Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Password" />
										<label asp-for="Password">Password</label>
										<span asp-validation-for="Password" class="text-danger"></span>
									</div>
								</div>
								<div class="col-12 col-md-6">
									<div class="form-floating">
										<input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm Password" />
										<label asp-for="ConfirmPassword">Confirm Password</label>
										<span asp-validation-for="ConfirmPassword" class="text-danger"></span>
									</div>
								</div>
							</div>

							<h6 class="mt-4 mb-2">Roles</h6>
							<div class="d-flex flex-wrap gap-3">
								@for (int i = 0; i < Model.Roles.Count; i++)
								{
									<div class="form-check">
										<input type="hidden" asp-for="@Model.Roles[i].RoleName" />
										<input asp-for="@Model.Roles[i].IsSelected" class="form-check-input" />
										<label asp-for="@Model.Roles[i].IsSelected" class="form-check-label">@Model.Roles[i].RoleName</label>
									</div>
								}
							</div>
							<span asp-validation-for="Roles"></span>
						</div>

						<div class="form-card-footer d-flex justify-content-end gap-2">
							<a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
							<button id="registerSubmit" type="submit" class="btn btn-primary">Save</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}