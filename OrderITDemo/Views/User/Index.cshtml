@model IEnumerable<UserViewModel>
@{
    ViewBag.Title = "Users";
}

<h1 class="text-center text-primary mt-5">@ViewBag.Title</h1>

<!-- إضافة زر إضافة مستخدم جديد -->
<div class="text-end mb-3">
    <a asp-action="Add" class="btn btn-success">Add New</a>
</div>

<!-- جدول المستخدمين -->
<div class="table-responsive">
    <table class="table table-striped table-bordered table-hover mt-4">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>UserName</th>
                <th>First Name</th>
                <th>Phone Number</th>
                <th>Email</th>
                <th>Roles</th>
                <th></th>
                <th>Actions</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.UserName</td>
                    <td>@user.FirstName</td>
                    <td>@user.PhoneNumber</td>
                    <td>@user.Email</td>
                    <td>@string.Join(", ", user.Roles.ToList())</td>
                    <td><a asp-action="ManageRoles" class="btn btn-primary" asp-controller="User" asp-route-userId="@user.Id">Manage Role</a></td>
                    <td><a asp-action="Edit" class="btn btn-outline-primary" asp-controller="User" asp-route-userId="@user.Id">Modify Profile</a></td>
                    <td><a href="javascript:;" data-id="@user.Id" class="btn btn-outline-danger js-delete">Delete</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function(){
            $('.js-delete').on('click',function(){
                var btn = $(this);

                var res = confirm("ARE YOU SURE TO DELETE THIS USER?");
                if(res){
                    $.ajax({
                        url: '/api/user/?userId='+btn.data('id'),
                        method: 'DELETE',
                        success: function(){
                            btn.parents('tr').fadeOut();
                            alert("USER DELETED");
                        },
                        error: function(){
                            alert('SOMETHING WENT WRONG!');
                        }
                    });
                }
            });
        });
    </script>
}