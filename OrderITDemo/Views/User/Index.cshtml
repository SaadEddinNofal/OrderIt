@model IEnumerable<UserViewModel>
@{
    
	Layout = "_AdminLayout";
	ViewBag.Title = "Users";

}

<div class="page-wrap">
	<div class="container py-5">
		<div class="page-header">
			<h1>@ViewBag.Title</h1>
			<p class="page-subtitle">Manage user accounts and their roles.</p>
		</div>

		<div class="admin-toolbar">
			<a asp-action="Add" class="btn btn-primary"><i class="bi bi-person-plus me-2"></i>Add New</a>
		</div>

		<div class="data-table table-responsive">
			<table class="table table-hover">
				<thead>
					<tr>
						<th>User</th>
						<th>Phone Number</th>
						<th>Email</th>
						<th>Roles</th>
						<th class="text-end">Actions</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var user in Model)
					{
						<tr>
							<td>
								<div class="fw-semibold">@user.UserName</div>
								<div class="text-muted small">@user.FirstName</div>
							</td>
							<td>@user.PhoneNumber</td>
							<td>@user.Email</td>
							<td>
								@foreach (var role in user.Roles.ToList())
								{
									<span class="role-badge @(role.ToLowerInvariant())">@role</span>
								}
							</td>
							<td class="text-end">
								<a asp-action="ManageRoles" asp-controller="User" asp-route-userId="@user.Id" class="btn btn-sm btn-outline-primary" title="Manage Role"><i class="bi bi-person-gear"></i></a>
								<a asp-action="Edit" asp-controller="User" asp-route-userId="@user.Id" class="btn btn-sm btn-outline-secondary" title="Modify Profile"><i class="bi bi-pencil"></i></a>
								<a href="javascript:;" data-id="@user.Id" class="btn btn-sm btn-outline-danger js-delete" title="Delete"><i class="bi bi-trash"></i></a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		$(document).ready(function () {
			$('.js-delete').on('click', function () {
				var btn = $(this);

				var res = confirm("ARE YOU SURE TO DELETE THIS USER?");
				if (res) {
					$.ajax({
						url: '/api/user/?userId=' + btn.data('id'),
						method: 'DELETE',
						success: function () {
							btn.parents('tr').fadeOut();
							alert("USER DELETED");
						},
						error: function () {
							alert('SOMETHING WENT WRONG!');
						}
					});
				}
			});
		});
	</script>
}