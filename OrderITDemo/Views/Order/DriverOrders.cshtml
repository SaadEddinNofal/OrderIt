@model IEnumerable<Order>
@{
    int i = 0;
}

<style>
    /* تحسين مظهر الصفحة */
    body {
        background-color: #ffcc66; /* لون برتقالي فاتح */
    }

    .my-div {
        width: 100%;
        height: 40px;
        position: relative;
        color: darkblue;
        font-weight: bolder;
    }

    /* تحسين مظهر الجدول ليكون متجاوبًا */
    table {
        width: 100%;
        table-layout: fixed;
    }

    .table th, .table td {
        word-wrap: break-word;
    }

    /* تحسين الأزرار داخل الـ accordion */
    .accordion-button {
        background-color: #007bff;
        color: white;
    }

        .accordion-button:focus {
            box-shadow: none;
        }

    /* إضافة خلفية للـ accordion */
    .accordion-item {
        margin-bottom: 10px;
        border: 1px solid #007bff;
        border-radius: 5px;
    }

    .accordion-body {
        background-color: #f8f9fa;
    }

    /* تحسين الأزرار في الـ accordion */
    .btn-danger {
        background-color: #dc3545;
        border: none;
    }

        .btn-danger:hover {
            background-color: #c82333;
        }

    /* إضافة تنسيق متجاوب */
  
    .accordion-body {
        padding: 1rem;
    }

    table {
        font-size: 12px;
    }

    }

    /* تحسين الألوان داخل الـ accordion */
    .accordion-header {
        background-color: #0069d9;
        color: white;
        padding: 10px;
    }

    .accordion-button:not(.collapsed) {
        color: #ffffff;
        background-color: #0056b3;
        border-color: #004085;
    }

</style>

@if (Model != null)
{
    @foreach (var order in Model)
    {
        <label hidden>@(i += 1)</label>
        <div class="accordion mt-2" id="accordionExample">
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingOne">
                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <button class="accordion-button collapsed" type="button"
                                data-bs-toggle="collapse" data-bs-target="#@i"
                                aria-expanded="true" aria-controls="@i" style="flex: 1;">
                            <span class="mx-3">@(i)</span>
                            <span class="mx-3">@order.StartOrderDate</span>
                            <span>@order.OrderStatuss</span>
                            @if (order.OrderStatuss == Order.OrderStatus.UnderDelivery)
                            {
                                <span class="mx-1"> at @order.StartDeliveryDate </span>
                            }
                            <span class="mx-3">@order.User?.FirstName</span>
                            <span class="mx-3">@order.User?.PhoneNumber</span>
                            <span class="mx-3">@order.Address</span>
                        </button>

                        <!-- أيقونة خارج الزر حتى لا تفتح الـ Accordion -->
                        <div class="mx-2">
                            @if (order.OrderStatuss == Order.OrderStatus.UnderDelivery)
                            {
                                <a asp-action="DoneOrder" asp-controller="Order" asp-route-id="@order.OrderId"
                                   class="btn btn-danger btn-sm">
                                    <i class="bi bi-check-lg"></i>
                                </a>
                            }
                            @* يمكنك إضافة أزرار إضافية هنا حسب الحاجة *@
                        </div>
                    </div>
                </h2>
                <div id="@i" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#accordionExample">
                    <div class="accordion-body">
                        <table class="table table-bordered shadow-lg">
                            <thead class="table-dark">
                                <tr>
                                    <th>Name</th>
                                    <th>Quantity</th>
                                    <th>Price</th>
                                    <th>Total Price</th>
                                </tr>
                            </thead>

                            @foreach (var o in order.Orders)
                            {
                                <tbody class="table-info">
                                    <tr>
                                        <td>@o.MenuName</td>
                                        <td>@o.Quentity</td>
                                        <td>@(o.Price / o.Quentity)</td>
                                        <td>@o.Price</td>
                                    </tr>
                                </tbody>
                            }
                        </table>
                    </div>

                    <h5 class="mx-3">Total Amount: @order.TotalAmount</h5>
                </div>
            </div>
        </div>
    }

    <div>
        @if (ViewBag.CurrentPage > 1)
        {
            <a href="@Url.Action("ManageOrders", new { page = ViewBag.CurrentPage - 1 })">السابق</a>
        }

        @if (ViewBag.CurrentPage * 30 < ViewBag.TotalCount)
        {
            <a href="@Url.Action("ManageOrders", new { page = ViewBag.CurrentPage + 1 })">التالي</a>
        }
    </div>
}