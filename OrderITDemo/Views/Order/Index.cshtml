@model IEnumerable<Order>
@{
	int i = 0;
}
<style>
	body {
		background-color: #fff8e1;
		font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
	}

	.accordion-button {
		background-color: #f0f0f0;
		color: #333;
	}

	.accordion-header {
		background-color: #ffe0b2;
		border-radius: 6px;
		padding: 0 10px;
	}

	.btn-icon {
		padding: 5px 10px;
	}
</style>

@if (Model != null)
{
	@foreach (var order in Model)
	{
		<label hidden>@(i += 1)</label>
		<div class="accordion mt-3" id="accordionExample">
			<div class="accordion-item">

				<h2 class="accordion-header d-flex justify-content-between align-items-center" id="heading@i">
					<!-- Accordion toggle button -->
					<button class="accordion-button collapsed flex-grow-1" type="button"
							data-bs-toggle="collapse" data-bs-target="#@i"
							aria-expanded="false" aria-controls="@i">
						<span class="mx-2 fw-bold text-primary">#@i</span>
						<span class="mx-2">@order.StartOrderDate.ToString("yyyy-MM-dd HH:mm")</span>
						<span class="mx-2">@order.OrderStatuss</span>
					</button>

					<!-- Action buttons outside toggle -->
					<div class="d-flex align-items-center px-2">
						@if (order.OrderStatuss == Order.OrderStatus.Pendeing)
						{
							<a asp-action="Delete" asp-controller="Order" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-danger mx-1" title="Delete">
								<i class="bi bi-trash3"></i>
							</a>
						}
					</div>
				</h2>

				<div id="@i" class="accordion-collapse collapse" aria-labelledby="heading@i" data-bs-parent="#accordionExample">
					<div class="accordion-body">
						<table class="table table-bordered shadow-sm">
							<thead class="table-dark text-center">
								<tr>
									<td>Name</td>
									<td>Quantity</td>
									<td>Unit Price</td>
									<td>Total Price</td>
								</tr>
							</thead>
							<tbody class="table-light">
								@foreach (var o in order.Orders)
								{
									<tr>
										<td>@o.MenuName</td>
										<td>@o.Quentity</td>
										<td>@(o.Price / o.Quentity)</td>
										<td>@o.Price</td>
									</tr>
								}
							</tbody>
						</table>
						<h5 class="text-end px-3">Total Amount: <strong>@order.TotalAmount</strong></h5>
					</div>
				</div>

			</div>
		</div>
	}

	<!-- Pagination -->
	<div class="d-flex justify-content-center mt-4">
		@if (ViewBag.CurrentPage > 1)
		{
			<a href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1 })" class="btn btn-outline-secondary mx-2">السابق</a>
		}
		@if (ViewBag.CurrentPage * 30 < ViewBag.TotalCount)
		{
			<a href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1 })" class="btn btn-outline-secondary mx-2">التالي</a>
		}
	</div>
}

@if (Model == null || !Model.Any())
{
	<div class="text-center mt-5">
		<img src="~/Images/empty-cart.png" class="img-fluid" alt="No orders" style="max-width: 300px;" />
		<h4 class="mt-3 text-muted">لا توجد طلبات</h4>
	</div>
}