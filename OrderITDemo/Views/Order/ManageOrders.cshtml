@model IEnumerable<Order>
@{
    int i = 0;
}
<style>
    body {
        background-color: #fff8e1;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .accordion-button {
        background-color: #f8f9fa;
        font-weight: 600;
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .accordion-body table td, .accordion-body table th {
        vertical-align: middle;
    }

    .order-actions {
        margin-left: auto;
        display: flex;
        gap: 0.5rem;
    }

    .dropdown .btn {
        font-weight: bold;
    }
</style>

<div class="container mt-4">

    <div class="dropdown">
        <button class="dropdown-toggle btn btn-outline-dark mb-4" data-bs-toggle="dropdown" aria-expanded="false">
            @ViewBag.DD
        </button>
        <ul class="dropdown-menu">
            <li><a class="dropdown-item" asp-controller="Order" asp-action="ManageOrders">All</a></li>
            <li><a class="dropdown-item" asp-controller="Order" asp-action="CancelOrder">Canceled Orders</a></li>
            <li><a class="dropdown-item" asp-controller="Order" asp-action="PendeingOrder">Pending Orders</a></li>
            <li><a class="dropdown-item" asp-controller="Order" asp-action="ProcessingOrder">Processing Orders</a></li>
        </ul>
    </div>

    @if (Model != null)
    {
        <div class="accordion" id="accordionExample">
            @foreach (var order in Model)
            {
                i++;
                <div class="accordion-item mb-3 shadow-sm">
                    <h2 class="accordion-header d-flex justify-content-between align-items-center px-2" id="heading@i" style="gap: 10px;">
                        <button class="accordion-button collapsed flex-grow-1" type="button" data-bs-toggle="collapse" data-bs-target="#@i" aria-expanded="false" aria-controls="@i">
                            <span class="me-3 fw-bold text-primary">#@i</span>
                            <span class="me-3">@order.StartOrderDate.ToString("yyyy-MM-dd HH:mm")</span>
                            <span class="me-3">@order.OrderStatuss</span>

                            @if (order.OrderStatuss == Order.OrderStatus.UnderDelivery && order.DeliveryId != null)
                            {
                                <span class="me-3 text-success">Driver: @order.Delivery.FirstName - @order.Delivery.PhoneNumber</span>
                                <span class="me-3">Started: @order.StartDeliveryDate</span>
                            }

                            @if (order.OrderStatuss == Order.OrderStatus.Processing && order.DeliveryId != null)
                            {
                                <span class="me-3 text-success">Driver: @order.Delivery.FirstName - @order.Delivery.PhoneNumber</span>
                            }

                            <span class="me-3">User: @order.User?.FirstName - @order.User?.PhoneNumber</span>
                        </button>

                        <div class="order-actions d-flex gap-1 ms-2">
                            @if (order.OrderStatuss == Order.OrderStatus.Pendeing)
                            {
                                <a asp-action="DeleteAdmin" asp-controller="Order" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash3"></i>
                                </a>
                                <a asp-action="AcceptOrder" asp-controller="Order" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-success" title="Accept">
                                    <i class="bi bi-check-lg"></i>
                                </a>
                            }
                            @if (order.OrderStatuss == Order.OrderStatus.Processing)
                            {
                                <a asp-action="OnDelivery" asp-controller="Order" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-warning" title="Start Delivery">
                                    <i class="bi bi-truck"></i>
                                </a>
                            }
                        </div>
                    </h2>

                    <div id="@i" class="accordion-collapse collapse" aria-labelledby="heading@i" data-bs-parent="#accordionExample">
                        <div class="accordion-body">
                            <table class="table table-bordered table-hover text-center">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Name</th>
                                        <th>Quantity</th>
                                        <th>Unit Price</th>
                                        <th>Total</th>
                                    </tr>
                                </thead>
                                <tbody class="table-light">
                                    @foreach (var o in order.Orders)
                                    {
                                        <tr>
                                            <td>@o.MenuName</td>
                                            <td>@o.Quentity</td>
                                            <td>@(o.Price / o.Quentity)</td>
                                            <td>@o.Price</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <h5 class="text-end me-2">Total Amount: <span class="text-success fw-bold">@order.TotalAmount</span></h5>
                        </div>
                    </div>
                </div>
            }
        </div>

        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @if (ViewBag.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("ManageOrders", new { page = ViewBag.CurrentPage - 1 })">السابق</a>
                    </li>
                }
                @if (ViewBag.CurrentPage * 30 < ViewBag.TotalCount)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("ManageOrders", new { page = ViewBag.CurrentPage + 1 })">التالي</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>