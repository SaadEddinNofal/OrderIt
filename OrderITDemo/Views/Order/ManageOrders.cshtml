@model IEnumerable<Order>
@{
	
	Layout = "_AdminLayout";
	ViewData["Title"] = "Manage Orders";
	int i = 0;

	string BadgeClass(Order.OrderStatus status) => status switch
	{
		Order.OrderStatus.Pendeing => "status-pending",
		Order.OrderStatus.Processing => "status-processing",
		Order.OrderStatus.UnderDelivery => "status-underdelivery",
		Order.OrderStatus.Delivered => "status-delivered",
		Order.OrderStatus.Cancelled => "status-cancelled",
		_ => "status-pending"

	};
}

<div class="page-wrap">
	<div class="container py-5">
		<div class="page-header">
			<h1>@ViewBag.DD</h1>
			<p class="page-subtitle">Review, accept and manage customer orders.</p>
		</div>

		<div class="filter-tabs">
			<a class="filter-tab @(string.Equals(ViewBag.DD?.ToString(), "All Orders", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-controller="Order" asp-action="ManageOrders">All</a>
			<a class="filter-tab" asp-controller="Order" asp-action="PendeingOrder">Pending</a>
			<a class="filter-tab" asp-controller="Order" asp-action="ProcessingOrder">Processing</a>
			<a class="filter-tab" asp-controller="Order" asp-action="CancelOrder">Cancelled</a>
		</div>

		@if (Model != null && Model.Any())
		{
			@foreach (var order in Model)
			{
				i++;
				<div class="order-card">
					<h2 class="order-card-header">
						<button class="flex-grow-1 d-flex flex-wrap align-items-center gap-3 text-start bg-transparent border-0 accordion-button collapsed"
								type="button" data-bs-toggle="collapse" data-bs-target="#orderBody@i" aria-expanded="false" aria-controls="orderBody@i">
							<span class="order-number">#@order.OrderId</span>
							<span class="order-meta">
								<span class="meta-item"><i class="bi bi-calendar-event"></i>@order.StartOrderDate.ToString("yyyy-MM-dd HH:mm")</span>
								<span class="meta-item"><i class="bi bi-person"></i>User: @order.User?.FirstName - @order.User?.PhoneNumber</span>
								@if (order.DeliveryId != null)
								{
									<span class="meta-item"><i class="bi bi-truck"></i>Driver: @order.Delivery?.FirstName - @order.Delivery?.PhoneNumber</span>
								}
								@if (order.OrderStatuss == Order.OrderStatus.UnderDelivery && order.DeliveryId != null)
								{
									<span class="meta-item"><i class="bi bi-clock"></i>Started: @order.StartDeliveryDate</span>
								}
							</span>
							<span class="status-badge @BadgeClass(order.OrderStatuss)">@order.OrderStatuss</span>
						</button>
						<span class="order-actions">
							@if (order.OrderStatuss == Order.OrderStatus.Pendeing)
							{
								<a asp-action="DeleteAdmin" asp-controller="Order" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash3"></i></a>
								<a asp-action="AcceptOrder" asp-controller="Order" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-success" title="Accept"><i class="bi bi-check-lg"></i></a>
							}
							@if (order.OrderStatuss == Order.OrderStatus.Processing)
							{
								<a asp-action="OnDelivery" asp-controller="Order" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-warning" title="Start Delivery"><i class="bi bi-truck"></i></a>
							}
						</span>
					</h2>

					<div id="orderBody@i" class="accordion-collapse collapse">
						<div class="order-card-body">
							<div class="table-responsive">
								<table class="table table-hover">
									<thead>
										<tr>
											<th>Name</th>
											<th>Quantity</th>
											<th>Unit Price</th>
											<th class="text-end">Total</th>
										</tr>
									</thead>
									<tbody>
										@foreach (var o in order.Orders)
										{
											<tr>
												<td>@o.MenuName</td>
												<td>@o.Quentity</td>
												<td>@(o.Price / o.Quentity)</td>
												<td class="text-end fw-semibold">@o.Price</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
							<div class="order-total">
								<span>Total Amount</span>
								<span class="amount">@order.TotalAmount ل.س</span>
							</div>
						</div>
					</div>
				</div>
			}

			<nav class="mt-4">
				<ul class="pagination justify-content-center">
					@if (ViewBag.CurrentPage > 1)
					{
						<li class="page-item">
							<a class="page-link" href="@Url.Action("ManageOrders", new { page = ViewBag.CurrentPage - 1 })"><i class="bi bi-chevron-right me-1"></i>السابق</a>
						</li>
					}
					@if (ViewBag.CurrentPage * 30 < ViewBag.TotalCount)
					{
						<li class="page-item">
							<a class="page-link" href="@Url.Action("ManageOrders", new { page = ViewBag.CurrentPage + 1 })">التالي<i class="bi bi-chevron-left ms-1"></i></a>
						</li>
					}
				</ul>
			</nav>
		}
		else
		{
			<div class="empty-state">
				<i class="bi bi-inbox empty-icon"></i>
				<h3>No orders found</h3>
				<p>There are no orders in this view right now.</p>
			</div>
		}
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}