@model IEnumerable<Order>
@{
	int i = 0;
}
<style>
	.my-div {
		width: 100%;
		height: 40px;
		position: relative;
		font-family: 'Lucida Sans', 'Lucida Sans Regular', 'Lucida Grande', 'Lucida Sans Unicode', Geneva, Verdana, sans-serif;
		color: darkblue;
		font-weight: bolder
	}

	body {
		background-color: darkorange
	}
</style>
@* <img class="bkimg" src="~/Images/BKORANGE.jpg" /> *@

@if (Model != null)
{
	@foreach (var order in Model)
	{
		<label hidden>@(i += 1)</label>
		<div class="accordion mt-2" id="accordionExample">
			<div class="accordion-item	">
				<h2 class="accordion-header" id="headingOne">
					<div style="display: flex; align-items: center;">
						<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@i" aria-expanded="true" aria-controls="@i" style="width:90%">
							<span class="mx-3">@(i)</span>
							<span class="mx-3">@order.StartOrderDate</span>
							<span>@order.OrderStatuss</span>
							@if (order.OrderStatuss == Order.OrderStatus.UnderDelivery)
							{
								<span class="mx-1"> at @order.StartDeliveryDate </span>
							}
							<span class="mx-3">@order.User?.FirstName</span>
							<span class="mx-3">@order.User?.PhoneNumber</span>
							<span class="mx-3">@order.Address</span>
						</button>
						
						@if (order.DeliveryId == null)
						{
							<a asp-action="IsTaken" asp-controller="Order" asp-route-id="@order.OrderId" class="btn btn-danger btn-sm mx-3">
								<i class="bi bi-check-lg"></i>
							</a>
						}


					</div>
				</h2>
				<div id="@i" class="accordion-collapse collapse " aria-labelledby="headingOne" data-bs-parent="#accordionExample">
					<div class="accordion-body">
						<table class="table table-bordered shadow-lg">
							<thead class="table-dark">
								<tr>
									<td>Name</td>
									<td>Quentity</td>
									<td>Price</td>
									<td>Total price</td>

								</tr>
							</thead>

							@foreach (var o in order.Orders)
							{

								<tbody class="table-info">

									<tr>
										<td>@o.MenuName</td>
										<td>@o.Quentity</td>
										<td>@(o.Price / o.Quentity)</td>
										<td>@o.Price</td>

									</tr>

								</tbody>

							}
						</table>
					</div>

					<h5 class="mx-3">Total Amount:  @order.TotalAmount</h5>

				</div>

			</div>
		</div>


	}
	<div>
		@if (ViewBag.CurrentPage > 1)
		{
			<a href="@Url.Action("ManageOrders", new { page = ViewBag.CurrentPage - 1 })">السابق</a>
		}

		@if (ViewBag.CurrentPage * 30 < ViewBag.TotalCount)
		{
			<a href="@Url.Action("ManageOrders", new { page = ViewBag.CurrentPage + 1 })">التالي</a>
		}
	</div>

}