@model IEnumerable<Category>

@{
    
	Layout = "_AdminLayout";
	ViewBag.Title = "The Categories";

}

<div class="page-wrap">
	<div class="container py-5">
		<div class="page-header">
			<h1>@ViewBag.Title</h1>
			<p class="page-subtitle">Organize the menu into categories.</p>
		</div>

		<div class="admin-toolbar">
			<a asp-action="Add" asp-controller="Category" class="btn btn-primary"><i class="bi bi-plus-circle me-2"></i>Add Category</a>
		</div>

		<div class="data-table table-responsive">
			<table class="table table-hover">
				<thead>
					<tr>
						<th>Name</th>
						<th>Description</th>
						<th class="text-end">Manage</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var item in Model)
					{
						<tr>
							<td class="fw-semibold">@item.Name</td>
							<td>@item.Description</td>
							<td class="text-end">
								<a asp-action="Add" asp-controller="Category" asp-route-id="@item.CategoryId" class="btn btn-sm btn-outline-primary me-1" title="Modify"><i class="bi bi-pencil"></i></a>
								<a asp-action="Delete" asp-controller="Category" asp-route-id="@item.CategoryId" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}