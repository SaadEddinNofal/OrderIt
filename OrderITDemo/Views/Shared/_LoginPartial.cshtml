@using Microsoft.AspNetCore.Identity
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

<ul class="navbar-nav user-area">
	@if (SignInManager.IsSignedIn(User))
	{
		@if (UserManager.GetUserAsync(User).Result.ProfilePicture != null)
		{
			<li class="nav-item">
				<img class="rounded-circle nav-avatar" src="data:image/*;base64,@(Convert.ToBase64String(UserManager.GetUserAsync(User).Result.ProfilePicture))" alt="Profile picture" />
			</li>
		}
		<li class="nav-item">
			<a class="nav-link user-chip" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage account">Hello @User.Identity?.Name!</a>
		</li>
		<li class="nav-item">
			<form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
				<button type="submit" class="btn btn-outline-secondary btn-sm logout-btn">Logout</button>
			</form>
		</li>
	}
	else
	{
		<li class="nav-item">
			<a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Register</a>
		</li>
		<li class="nav-item ms-lg-2">
			<a class="btn btn-primary btn-sm nav-cta" asp-area="Identity" asp-page="/Account/Login">Login</a>
		</li>
	}
</ul>