@model IEnumerable<IdentityRole>
@{
    ViewData["Title"] = "The Roles";
}
<div class="container">
   
    <partial name="_RoleForm" model="new RoleFormViewModel()" />

  
    <div class="table-responsive mt-4">
        <table class="table table-striped shadow-lg mb-0">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Role Name</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model)
                {
                    <tr>
                        <td>@role.Id</td>
                        <td>@role.Name</td>
                        <td>
                            <a asp-action="Delete" asp-controller="Role" class="btn btn-danger btn-sm" asp-route-id="@role.Id">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}  