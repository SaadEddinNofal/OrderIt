@model IEnumerable<IdentityRole>
@{
    
	Layout = "_AdminLayout";
	ViewData["Title"] = "The Roles";

}

<div class="page-wrap">
	<div class="container py-5">
		<div class="page-header">
			<h1>@ViewData["Title"]</h1>
			<p class="page-subtitle">Define the roles used across the application.</p>
		</div>

		<div class="form-card mb-4">
			<div class="form-card-header">
				<h2 class="h6 mb-0">Add New Role</h2>
			</div>
			<div class="form-card-body">
				<partial name="_RoleForm" model="new RoleFormViewModel()" />
			</div>
		</div>

		<div class="data-table table-responsive">
			<table class="table table-hover">
				<thead>
					<tr>
						<th>Id</th>
						<th>Role Name</th>
						<th class="text-end">Actions</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var role in Model)
					{
						<tr>
							<td>@role.Id</td>
							<td>@role.Name</td>
							<td class="text-end">
								<a asp-action="Delete" asp-controller="Role" class="btn btn-sm btn-outline-danger" asp-route-id="@role.Id"><i class="bi bi-trash me-1"></i>Delete</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}