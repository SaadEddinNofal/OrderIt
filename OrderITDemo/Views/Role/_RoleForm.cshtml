@model RoleFormViewModel
<form method="post" asp-action="Add">
	<div class="input-group mb-3" style="width:250px">
		<input asp-for="Name" class="form-control mb-2 " placeholder="Enter Role Name"  />
		<div class="input-group">
			<button type="submit" class="btn btn-danger">Add New Role</button>
		</div>
	</div>
	<span asp-validation-for="Name" class="text-bg-danger"></span>
</form>