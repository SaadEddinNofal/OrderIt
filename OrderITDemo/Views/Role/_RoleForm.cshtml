@model RoleFormViewModel
<form method="post" asp-action="Add">
	<div class="row g-2 align-items-end">
		<div class="col-md-6">
			<div class="form-floating">
				<input asp-for="Name" class="form-control" placeholder="Enter Role Name" />
				<label asp-for="Name">Role Name</label>
			</div>
			<span asp-validation-for="Name" class="text-danger small"></span>
		</div>
		<div class="col-md-auto">
			<button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add New Role</button>
		</div>
	</div>
</form>