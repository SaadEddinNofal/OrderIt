@{
    ViewData["Title"] = "Home";
}

<section class="hero">
	<div class="hero-content">
		<img src="~/Images/Logo3.png" class="hero-brand" alt="OrderIt logo" />
		<h1>Welcome to OrderIT</h1>
		<p>Discover restaurants and more near you.</p>
		<div class="hero-actions">
			<a class="btn btn-hero" asp-area="Identity" asp-page="/Account/Login">Login</a>
			<a class="btn btn-hero-outline" asp-area="Identity" asp-page="/Account/Register">Sign Up</a>
		</div>
	</div>
</section>

<section class="page-wrap">
	<div class="container">
		<div class="row g-4 py-5">
			<div class="col-md-6">
				<div class="feature-card">
					<div class="feature-icon"><i class="bi bi-bicycle"></i></div>
					<h3>Become a Dasher</h3>
					<p>Make money and work on your schedule. Contact us:</p>
					<p class="feature-contact">sarg10nofal10@gmail.com<br />0993735995</p>
				</div>
			</div>
			<div class="col-md-6">
				<div class="feature-card">
					<div class="feature-icon"><i class="bi bi-phone"></i></div>
					<h3>Use the Website</h3>
					<p>Experience the best your neighborhood has to offer, all in one place.</p>
					<a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Register">Sign Up</a>
				</div>
			</div>
		</div>

		<div class="cta-band mb-5">
			<div>
				<h2>Hungry? Order now.</h2>
				<p>Browse the menu and get delicious food delivered to your door.</p>
			</div>
			<a class="btn btn-light btn-lg fw-bold" asp-area="" asp-controller="Menu" asp-action="IndexUser">View Menu <i class="bi bi-arrow-right ms-1"></i></a>
		</div>
	</div>
</section>